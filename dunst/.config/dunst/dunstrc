[global]
font = Jetbrainsmono Nerd Font Bold 13
follow = mouse
markup = full
width = 350
frame_color = "#c4a7e7" ; Iris
highlight = "#ebbcba" ; Rose
separator_color = frame
origin = bottom-center
offset = 0x100
timeout = 2
show_age_threshold = 60
progress_bar_corner_radius = 5
corner_radius = 8

[urgency_low]
background = "#191724ba" ; Base 73% 
foreground = "#e0def4"  ; Text

[urgency_normal]
background = "#191724ba" ; Base 73% 
foreground = "#e0def4"  ; Text

[urgency_critical]
background = "#191724ba" ; Base 73% 
foreground = "#e0def4"  ; Text 
frame_color = "#eb6f92" ; Love 
